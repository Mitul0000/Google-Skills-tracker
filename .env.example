# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Rate Limiting & Concurrency
RATE_PER_SEC=8.0
BURST_CAPACITY=8.0
MAX_CONCURRENCY=8

# Retry & Backoff
MAX_ATTEMPTS=4
BASE_BACKOFF=1.0
MAX_BACKOFF=10.0

# Sessions & Storage
DATABASE_PATH=lwc_tracker.db
SESSION_TTL_SECONDS=7200
CLEANUP_INTERVAL_SECONDS=300
MAX_ROWS_PER_UPLOAD=1000
MAX_UPLOAD_SIZE_BYTES=2097152

# Mode
MOCK_FETCH=0
